#!/bin/sh
set -eu

# ----------------------------------------------------------------------------------------------------------------------

echo "► Starting Production Entrypoint..."

# opcache.file_cache (prod-php.ini) must exist, or PHP 8.5+ refuses to start. Create it at runtime because /tmp
# may be an empty mount (e.g. a Kubernetes emptyDir).
mkdir -p /tmp/opcache

# ----------------------------------------------------------------------------------------------------------------------

# Run custom ad-hoc pre-run script
echo "► Running custom pre-run (prod) script..."
pre-run-prod

# ----------------------------------------------------------------------------------------------------------------------

# Run Entrypoint and pass CMD to it (Don't forget exec)
exec entrypoint-base "${@}"
